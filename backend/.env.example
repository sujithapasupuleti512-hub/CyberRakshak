# CyberRakshak backend environment variables.
# Copy to .env and adjust for your environment.

# Security - generate a strong random value for production, e.g.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database. SQLite by default (good for local development).
# For production Postgres (e.g. Neon/Render/Supabase) set the full connection
# string as an environment variable in your host's dashboard - never commit it:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# (Legacy "postgres://" URLs are accepted and normalized automatically.)
DATABASE_URL=sqlite:///./cyberrakshak.db

# Comma separated list of allowed frontend origins (no trailing slash).
# Example: CORS_ORIGINS=https://cyber-rakshak.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
