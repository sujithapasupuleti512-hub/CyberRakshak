# Base URL for the FastAPI backend.
# Local development: leave empty — the Vite dev server proxies /api to http://127.0.0.1:8000.
# Production (Vercel): set VITE_API_URL to your deployed backend origin, e.g.
#   VITE_API_URL=https://cyberrakshak-api.onrender.com
# Never use a localhost URL in production.
VITE_API_URL=
