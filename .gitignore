*.db
*.sqlite
*.sqlite3

# ---------- Node / React frontend ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

