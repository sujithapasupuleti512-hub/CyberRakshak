# ---------- Secrets / environment ----------
# Never commit real environment files. Keep the *.example templates.
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Python / FastAPI backend ----------
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
